DECISIONERR_URL=http://127.0.0.1:8790
DECISIONERR_TOKEN=<arr-agent token from apps.json>
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=<key>
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=<key>
# 1 = log decisions only. Set to 0 to let it grab.
DRY_RUN=1
MAX_TARGETS=4
MAX_GRABS=2
MIN_CONFIDENCE=0.75
COOLDOWN_HOURS=72
# Retry sooner when a search found nothing (e.g. an indexer was down)
EMPTY_RETRY_HOURS=8
MIN_AIRED_HOURS=48
